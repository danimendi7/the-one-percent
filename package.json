{
  "name": "the-one-percent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --grep-invert @screens",
    "check": "npm run typecheck && npm run lint && npm run test",
    "verify": "npm run check && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "screenshots": "playwright test --grep @screens",
    "icons": "node scripts/generate-icons.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "cloud": "node scripts/cloud.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "backup:verify": "node scripts/backup-verify.mjs",
    "smoke": "playwright test --config playwright.smoke.config.ts",
    "cloud:auth": "node scripts/cloud-auth.mjs",
    "e2e:linux": "node scripts/e2e-linux.mjs",
    "bench:knowledge": "node scripts/bench-knowledge.mjs",
    "test:browser": "playwright test --config playwright.browser.config.ts",
    "bench:search": "node scripts/bench-search.mjs",
    "explore:metadata": "vitest run --config vitest.explore.config.mts --silent=false"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
