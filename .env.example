# THE ONE PERCENT — environment template.
# Copy to .env.local (git-ignored). Never commit real values.
# M0/M1 need NO environment variables: the prototype runs fully offline with local demo data.

# ── M2: Supabase (dedicated project for THE ONE PERCENT only) ─────────────
# Local development values are printed by `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ and never import from client components.
SUPABASE_SERVICE_ROLE_KEY=

# ── M4: Book metadata (server-only, optional) ─────────────────────────────
GOOGLE_BOOKS_API_KEY=

# ── M5: Web push (server-only private key) ───────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# ── M6: Optional AI provider adapter (server-only, rate-limited) ─────────
AI_PROVIDER=
AI_API_KEY=
AI_MONTHLY_TOKEN_BUDGET=
