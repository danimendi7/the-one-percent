# THE ONE PERCENT — environment template.
# Copy to .env.local (git-ignored). Never commit real values.
# Without these two variables the app runs in local demo mode only.

# ── Supabase (public values only) ─────────────────────────────────────────
# Local: printed by `npm run db:start` / `npx supabase status` (API_URL, PUBLISHABLE_KEY).
# Cloud (later, with authorization): Project Settings → API → URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The app itself never uses the secret (service-role) key. Only the scheduled push route does (below).

# ── M4: Book metadata (server-only, optional) ─────────────────────────────
GOOGLE_BOOKS_API_KEY=

# ── E8: Web push. Generate a pair with `npx web-push generate-vapid-keys`; the public key goes in the
# build, the private key only on the server. Without all three, push is off and reminders stay in the inbox.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# ── E9: Scheduled push (server-only). Called every 5 min by pg_cron + pg_net with this secret (32+ chars),
# which also goes into Supabase Vault as `push_dispatch_secret`. The secret key lets the route read each
# person's data to evaluate the Motivation Engine. Without both, /api/push/dispatch answers 503.
PUSH_DISPATCH_SECRET=
SUPABASE_SECRET_KEY=

# ── E4: Optional AI provider adapter (server-only, off unless all three are set and the provider is supported) ──
AI_PROVIDER=
AI_API_KEY=
AI_MONTHLY_TOKEN_BUDGET=
