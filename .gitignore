# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# backups (Orden 3): they go to ~/Documents/the-one-percent-backups, but never into git if --dir points here
*.topbak
*.topbak.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow the documented example env file (never real secrets)
!.env.example

# playwright
/test-results/
/playwright-report/
/playwright-report-smoke/
/e2e-results/
/blob-report/
/playwright/.cache/
/logs/
.env.local
.env*.local
